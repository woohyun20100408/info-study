{
  "rules": {
    ".read": false,
    ".write": false,
    "rankings": {
      ".read": "auth != null",
      ".indexOn": [
        "xp"
      ],
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && (auth.token.firebase.sign_in_provider != 'anonymous' || !newData.exists())",
        ".validate": "newData.hasChildren(['uid', 'nickname', 'xp', 'level', 'solvedProblems', 'updatedAt'])",
        "uid": {
          ".validate": "newData.isString() && newData.val() === $uid"
        },
        "nickname": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "xp": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "level": {
          ".validate": "newData.isNumber() && newData.val() >= 1"
        },
        "solvedProblems": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
